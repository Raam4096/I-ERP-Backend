# Copy to .env for local overrides. Never commit real secrets.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ierp_dev
POSTGRES_USER=ierp
POSTGRES_PASSWORD=ierp

ConnectionStrings__PrimaryDatabase=Host=localhost;Port=5432;Database=ierp_dev;Username=ierp;Password=ierp
ConnectionStrings__ReportingDatabase=Host=localhost;Port=5432;Database=ierp_dev;Username=ierp;Password=ierp

Jwt__SigningKey=LOCAL_DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY

Redis__Enabled=false
Redis__ConnectionString=localhost:6379

Hangfire__Enabled=false

AzureServiceBus__Enabled=false
AzureOpenAI__Enabled=false
AzureBlobStorage__Enabled=false
